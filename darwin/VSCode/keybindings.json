// Place your key bindings in this file to override the defaults
[
  {
    "command": "-cursorColumnSelectDown",
    "when": "editorColumnSelection && textInputFocus",
    "key": "shift+down"
  },
  {
    "command": "-cursorColumnSelectDown",
    "when": "textInputFocus",
    "key": "shift+alt+cmd+down"
  },
  {
    "command": "-cursorColumnSelectUp",
    "when": "editorColumnSelection && textInputFocus",
    "key": "shift+up"
  },
  {
    "command": "-cursorColumnSelectUp",
    "when": "textInputFocus",
    "key": "shift+alt+cmd+up"
  },
  {
    "command": "-editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
    "key": "shift+alt+f"
  },
  {
    "command": "-editor.action.insertCursorAtEndOfEachLineSelected",
    "when": "editorTextFocus",
    "key": "shift+alt+i"
  },
  {
    "command": "-extension.vim_ctrl+v",
    "when": "editorTextFocus && vim.active && vim.use<C-v> && !inDebugRepl",
    "key": "ctrl+v"
  },
  {
    "command": "-markdown.extension.editing.toggleBold",
    "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/",
    "key": "cmd+b"
  },
  {
    "command": "-workbench.action.zoomIn",
    "key": "cmd+="
  },
  {
    "command": "-workbench.action.zoomOut",
    "key": "cmd+-"
  },
  {
    "command": "cursorColumnSelectDown",
    "when": "editorColumnSelection && textInputFocus",
    "key": "j"
  },
  {
    "command": "cursorColumnSelectUp",
    "when": "editorColumnSelection && textInputFocus",
    "key": "k"
  },
  {
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
    "key": "cmd+-"
  },
  {
    "command": "editor.action.insertCursorAtEndOfEachLineSelected",
    "when": "editorTextFocus",
    "key": "ctrl+v"
  },
  {
    "command": "editor.action.toggleColumnSelection",
    "key": "ctrl+v"
  },
  {
    "command": "github.copilot.interactiveEditor.generateDocs",
    "key": "ctrl+shift+d"
  },
  {
    "key": "cmd+l cmd+o",
    "command": "-extension.liveServer.goOnline",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+l cmd+c",
    "command": "-extension.liveServer.goOffline",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+l",
    "command": "-expandLineSelection",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+`",
    "command": "-maximizeterminal.openMinimizedTerminal",
    "when": "config.maximizeterminal.useAlternativeKeybinding && !activeAuxiliary && !activePanel"
  },
  {
    "key": "ctrl+[IntlBackslash]",
    "command": "maximizeterminal.closeMaximizedTerminal",
    "when": "config.maximizeterminal.useAlternativeKeybinding && focusedView == 'terminal'"
  },
  {
    "key": "ctrl+;",
    "command": "-maximizeterminal.closeMaximizedTerminal",
    "when": "config.maximizeterminal.useAlternativeKeybinding && focusedView == 'terminal'"
  },
  {
    "key": "ctrl+[IntlBackslash]",
    "command": "maximizeterminal.openMaximizedTerminal",
    "when": "config.maximizeterminal.useAlternativeKeybinding && !activeAuxiliary && !activePanel"
  },
  {
    "key": "ctrl+;",
    "command": "-maximizeterminal.openMaximizedTerminal",
    "when": "config.maximizeterminal.useAlternativeKeybinding && !activeAuxiliary && !activePanel"
  },
  {
    "key": "ctrl+[IntlBackslash]",
    "command": "maximizeterminal.closeMaximizedTerminal",
    "when": "focusedView == 'terminal'"
  },
  {
    "key": "ctrl+`",
    "command": "-maximizeterminal.closeMaximizedTerminal",
    "when": "focusedView == 'terminal'"
  },
  {
    "key": "ctrl+[IntlBackslash]",
    "command": "maximizeterminal.openMaximizedTerminal",
    "when": "!activeAuxiliary && !activePanel && !config.maximizeterminal.useAlternativeKeybinding"
  },
  {
    "key": "ctrl+`",
    "command": "-maximizeterminal.openMaximizedTerminal",
    "when": "!activeAuxiliary && !activePanel && !config.maximizeterminal.useAlternativeKeybinding"
  },
  {
    "key": "ctrl+`",
    "command": "-workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "ctrl+`",
    "command": "workbench.action.closePanel"
  },
  {
    "key": "shift+cmd+r",
    "command": "workbench.action.reloadWindow"
  },
  {
    "key": "shift+cmd+r",
    "command": "-workbench.action.reloadWindow",
    "when": "isDevelopment"
  }
]