{
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[dotenv]": {
    "editor.defaultFormatter": "IronGeek.vscode-env"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "editor.suggest.insertMode": "replace"
  },
  "[javascript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[javascript][typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnType": true
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": false
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "'Cartograph CF', Menlo, Monaco, 'Courier New', monospace",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "keyword.other.dotenv",
        "settings": {
          "foreground": "#FF000000"
        }
      }
    ]
  },
  "editor.wordWrap": "on",
  "eslint.format.enable": true,
  "eslint.useFlatConfig": true,
  "evenBetterToml.formatter.alignComments": true,
  "evenBetterToml.formatter.alignEntries": true,
  "evenBetterToml.formatter.allowedBlankLines": 1,
  "evenBetterToml.formatter.arrayAutoExpand": true,
  "evenBetterToml.formatter.arrayTrailingComma": true,
  "evenBetterToml.formatter.columnWidth": 120,
  "evenBetterToml.formatter.indentEntries": true,
  "evenBetterToml.formatter.indentString": "  ",
  "evenBetterToml.formatter.indentTables": true,
  "evenBetterToml.formatter.inlineTableExpand": true,
  "evenBetterToml.formatter.reorderArrays": true,
  "evenBetterToml.formatter.reorderKeys": true,
  "explorer.confirmDragAndDrop": false,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "*.env*": "env",
    "*.env.local": "env",
    "*.env.production": "env",
    "*.scss": "scss",
    "*.tmpl": "shellscript",
    ".env": "env",
    ".env*": "dotenv",
    ".env.base": "env"
  },
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.defaultBranchName": "trunk",
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false
  },
  "github.gitProtocol": "ssh",
  "gitlens.plusFeatures.enabled": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "liveServer.settings.NoBrowser": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "markdown.extension.toc.levels": "2..6",
  "material-icon-theme.activeIconPack": "angular_ngrx",
  "material-icon-theme.files.associations": {
    "*.env.base": "tune",
    "*.env.dist": "tune",
    "Caddyfile.base": "caddy"
  },
  "material-icon-theme.folders.associations": {
    "packages": "Packages"
  },
  "projectManager.tags": [
    "[Nos Futurs] Clients",
    "[Nos Futurs] Internal",
    "[Nos Futurs] Tools",
    "[Dev]",
    "[Dev] AI",
    "[Dev] Games",
    "[Dev] Learning",
    "[Writing]"
  ],
  "python.languageServer": "Pylance",
  "redhat.telemetry.enabled": false,
  "rewrap.autoWrap.enabled": true,
  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.untrustedFiles": "newWindow",
  "sortJSON.orderOverride": [
    "name",
    "version",
    "description",
    "license",
    "command",
    "when"
  ],
  "sortJSON.orderUnderride": [
    "dependencies",
    "devDependencies",
    "peerDependencies"
  ],
  "svg.preview.mode": "svg",
  "terminal.integrated.env.osx": {
    "CW_NEW_SESSION": "1"
  },
  "todo-tree.general.tags": [
    "BUG",
    "DEBUG",
    "FIX",
    "FIXME",
    "INFO",
    "TODO",
    "WARNING",
  ],
  "todo-tree.general.tagGroups": {
    "FIXME": [
      "FIXME",
      "FIX",
    ],
    "INFO": [
      "DEBUG",
      "INFO",
    ],
    "WARNING": [
      "BUG",
      "WARNING",
    ],
  },
  "todo-tree.highlights.defaultHighlight": {
    "gutterIcon": true,
    "opacity": 50,
    "type": "text-and-comment",
  },
  "todo-tree.highlights.customHighlight": {
    "FIXME": {
      "background": "rgba(255, 99, 71, 0.2)",
      "foreground": "#cc3300",
      "icon": "tools",
      "iconColour": "#ff6347",
      "gutterIcon": true
    },
    "INFO": {
      "background": "rgba(144, 238, 144, 0.2)",
      "foreground": "#2e8b57",
      "icon": "info",
      "iconColour": "#90ee90",
      "gutterIcon": true
    },
    "TODO": {
      "background": "rgba(135, 206, 250, 0.2)",
      "foreground": "#4682b4",
      "icon": "checklist",
      "iconColour": "#87cefa",
      "gutterIcon": true
    },
    "WARNING": {
      "background": "rgba(255, 165, 0, 0.1)",
      "foreground": "#d2691e",
      "icon": "alert",
      "iconColour": "#ffa500",
      "gutterIcon": true
    }
  },
  "typeChallenges.workspaceFolder": "/Users/camille/Dev/type-challenges",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vim.handleKeys": {
    "<C-b>": false
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    // FIX https://github.com/VSCodeVim/Vim/issues/8157#issuecomment-1426704638
    // Wait for new release, else we should migrate to using vscode-neovim extension
    {
      "before": [
        "u"
      ],
      "commands": [
        "undo"
      ]
    },
    {
      "before": [
        "c-r"
      ],
      "commands": [
        "redo"
      ]
    }
  ],
  "vim.smartRelativeLine": true,
  "window.zoomLevel": 1,
  "workbench.colorTheme": "Default Light Modern",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.settings.applyToAllProfiles": [
    "database-client.telemetry.usesOnlineServices"
  ],
  "workbench.activityBar.location": "top",
  "maximizeterminal.useAlternativeKeybinding": true,
  "settingsSync.ignoredExtensions": [],
  "github.copilot.nextEditSuggestions.enabled": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "diffEditor.renderSideBySide": false,
  "chat.tools.terminal.autoApprove": {
    "pnpm": true,
    "/^node -e \"import\\('@zeus-shared/db-entities/zod'\\)\\.then\\(m => console\\.log\\(Object\\.keys\\(m\\)\\.includes\\('UserCreateInputObjectZodSchema'\\), Object\\.keys\\(m\\)\\.slice\\(0,20\\)\\)\\)\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "sed": true,
    "kubectl -n argocd": true,
    "kubectl auth": true,
    "helm": true
  },
  "yaml.format.singleQuote": true,
  "explorer.confirmDelete": false,
  "python.analysis.aiHoverSummaries": true,
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.chat.notebook.enhancedNextEditSuggestions.enabled": true,
  "github.copilot.chat.newWorkspace.useContext7": true,
  "github.copilot.chat.languageContext.typescript.includeDocumentation": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.alternateGptPrompt.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.tools.urls.autoApprove": {
    "https://sabnzbd.org/wiki/advanced/hostname-verification": true,
    "https://sabnzbd.org/wiki/advanced": true,
    "https://sabnzbd.org/wiki": true,
    "https://sabnzbd.org": true,
    "https://sabnzbd.org/wiki/advanced/hostname-verification.html": true,
    "https://sabnzbd.org/wiki/advanced/hostname_verification": true,
    "https://sabnzbd.org/wiki/configuration/4.5/general#security": true,
    "https://sabnzbd.org/wiki/configuration/4.5": true,
    "https://sabnzbd.org/wiki/configuration": true,
    "https://developer.mozilla.org": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "rust-analyzer.workspace.discoverConfig": null,
  "mypy-type-checker.cwd": "${nearestConfig}",
  "chat.mcp.gallery.enabled": true
}