# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load
# ZSH_THEME="powerlevel10k/powerlevel10k"

# Disable oh-my-zsh auto-updates: The oh-my-zsh folder is not a git folder but is managed by chezmoi
zstyle ':omz:update' mode disabled

# Change the ZSH_CUSTOM folder. It cannot be tracked since it is implicitely created by chezmoiexternal. See: https://github.com/twpayne/chezmoi/issues/1574
ZSH_CUSTOM=$HOME/.config/oh-my-zsh

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# ------------------------------ HISTORY Options ----------------------------- #
# Deletes old recorded entry if new entry is a duplicate.
setopt HIST_IGNORE_ALL_DUPS
# Do not record an entry that was just recorded again.
setopt HIST_IGNORE_DUPS
# Do not display duplicates of a line previously found when searching
setopt HIST_FIND_NO_DUPS
# Remove superfluous blanks from each command line being added to the history list.
setopt HIST_REDUCE_BLANKS
# Beep when accessing non-existent history.
setopt HIST_BEEP

# fzf-tab needs to be loaded after compinit, but before other zsh-auto-suggestions. See: https://github.com/Aloxaf/fzf-tab#install
autoload -Uz compinit && compinit
plugins=(
  argocd
  git
  kubectl
  my-functions
  rust
  vi-mode
  fzf-tab
  zsh-autosuggestions
  zsh-history-substring-search
  zsh-syntax-highlighting
)

# Add Proto (https://moonrepo.dev/proto) to the env
eval "$(proto activate zsh)"

# Add completions to Oh-My-Zsh: see https://github.com/zsh-users/zsh-completions/issues/603
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src

source $ZSH/oh-my-zsh.sh

# ---------------------------------------------------------------------------- #
#                              User configuration                              #
# ---------------------------------------------------------------------------- #
# You may need to manually set your language environment
export LANG=en_GB.UTF-8

# ------------------------------ Powershell 10k ------------------------------ #
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
# Source fuzzy completion
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# ---------------------------------------------------------------------------- #
#                                   Cursor                                     #
# ---------------------------------------------------------------------------- #
export EDITOR="/Applications/Cursor.app/Contents/MacOS/Cursor"

# ---------------------------------------------------------------------------- #
#                                Docker Desktop                                #
# ---------------------------------------------------------------------------- #
# Set default platform to amd64 instead of arm
# export DOCKER_DEFAULT_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------- #
#                                  Homebrew                                    #
# ---------------------------------------------------------------------------- #
# Add Homebrew to PATH
export PATH="/opt/homebrew/bin:$PATH"

# ---------------------------------------------------------------------------- #
#                                  Pay Respect                                 #
# ---------------------------------------------------------------------------- #
# See: https://codeberg.org/iff/pay-respects/
eval "$(pay-respects zsh --alias)"


# ---------------------------------------------------------------------------- #
#                                   Postgres                                   #
# ---------------------------------------------------------------------------- #
# Force libpq in path
export PATH="/usr/local/opt/libpq/bin:$PATH"

# ---------------------------------------------------------------------------- #
#                                   Starship                                   #
# ---------------------------------------------------------------------------- #
eval "$(starship init zsh)"

# ---------------------------------------------------------------------------- #
#                        DotNet workaround for Homebrew                        #
# ---------------------------------------------------------------------------- #
export DOTNET_ROOT="$(dirname $(which dotnet))"

# ---------------------------------------------------------------------------- #
#                                      Go                                      #
# ---------------------------------------------------------------------------- #
export GOROOT="$(go env GOROOT)"
export GOPATH="$(go env GOPATH)"
export PATH=$PATH:$GOPATH/bin
export PATH=$PATH:$GOROOT/bin
# export TWEEGO_PATH="$HOME/.tweego/storyformats"
# export PATH="$HOME/.tweego:$PATH"

# ------------------------------------ VIM ----------------------------------- #
# Set default editor to VIM
export EDITOR=nvim
export VISUAL="$EDITOR"

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/camille/.lmstudio/bin"

# Scaleway CLI autocompletion initialization
eval "$(scw autocomplete script shell=zsh)"

# Load custom functions
fpath+=~/.zfunc; autoload -Uz compinit; compinit